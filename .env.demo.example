# Copy to .env.demo, or run deploy/start-demo.ps1 to generate it from .env.
# Real keys and generated passwords must never be committed.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
JWT_ADMIN_SECRET=
JWT_USER_SECRET=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Applies on the first startup of the separate demo database.
ADMIN_APP_PASSWORD=

ADMIN_BASIC_AUTH_USER=demo-admin
# Used only by the local start/verification scripts. Caddy receives the hash.
ADMIN_BASIC_AUTH_PASSWORD=
# Use single quotes because bcrypt hashes contain dollar signs.
ADMIN_BASIC_AUTH_HASH=''
