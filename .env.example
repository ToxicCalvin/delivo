# Copy this file to .env in the repository root, then fill in every value.
# .env is ignored by Git. Never commit or share real passwords or API keys.

# Use different long, random passwords for MySQL root and the application user.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

# Use two different random strings (at least 32 characters each).
JWT_ADMIN_SECRET=
JWT_USER_SECRET=

# Required for Delivo's AI assistant.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
