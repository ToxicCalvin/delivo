# Copy to .env.public on the Linux server. Never commit that file.
# Use two different DNS names that point to the server.
USER_DOMAIN=demo.example.com
ADMIN_DOMAIN=admin.example.com

MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
JWT_ADMIN_SECRET=
JWT_USER_SECRET=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Set before the database volume is initialized. This replaces the SQL seed password.
ADMIN_APP_PASSWORD=

# Generate with: docker run --rm -it caddy:2 caddy hash-password
# Put the resulting hash in single quotes because it contains $ characters.
ADMIN_BASIC_AUTH_USER=demo-admin
ADMIN_BASIC_AUTH_HASH=''
